# Copy to .env.prod on the server and fill in. Never commit .env.prod.
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.prod ...

DEBUG=False
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=generate-a-long-random-string-here
ALLOWED_HOSTS=daycares.pk,www.daycares.pk
CSRF_TRUSTED_ORIGINS=https://daycares.pk,https://www.daycares.pk
# Raise to 31536000 (one year) once HTTPS is confirmed working
SECURE_HSTS_SECONDS=0

# Database (DB_HOST and REDIS_URL are set by docker-compose.prod.yml)
DB_NAME=daycare_db
DB_USER=daycare_user
DB_PASSWORD=strong-password-here
DB_PORT=5432

# Shown on the Contact and Privacy pages
CONTACT_EMAIL=hello@daycares.pk

# Leave empty until AdSense approves the site, then set ca-pub-...
ADSENSE_PUBLISHER_ID=

# SSL / Certbot: the domain without www (nginx and the certificate use it)
DOMAIN=daycares.pk
SSL_EMAIL=your@email.com
