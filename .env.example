# Which site to run: uae or pk (config/sites.py). SITE_NAME overrides the brand name.
SITE=uae
# Folder for listing photos (default: media). Give each site its own database
# and photo folder, e.g. for the parked Pakistan site:
#   SITE=pk  DB_NAME=daycare_pk  MEDIA_DIR=media_pk
MEDIA_DIR=media

DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=daycare_db
DB_USER=daycare_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Google AdSense (add once approved)
ADSENSE_PUBLISHER_ID=ca-pub-xxxxxxxxxxxxxxxx
